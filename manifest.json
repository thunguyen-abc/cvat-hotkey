{
  "manifest_version": 3,
  "name": "CVAT Event Hotkeys",
  "version": "1.8.3",
  "description": "Adds CVAT event shortcuts, job actions, and a GitHub release update checker.",
  "permissions": ["alarms", "nativeMessaging"],
  "host_permissions": ["https://api.github.com/*"],
  "background": {
    "service_worker": "updates.js"
  },
  "action": {
    "default_title": "CVAT Event Hotkeys",
    "default_popup": "update.html"
  },
  "content_scripts": [
    {
      "matches": ["https://cvat-tai.abcstudio.online/*"],
      "js": ["cvat-bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://cvat-tai.abcstudio.online/*"],
      "js": ["range-plan.js", "bridge-client.js", "hotkeys.js", "range-editor.js", "complete-next.js"],
      "css": ["complete-next.css"],
      "run_at": "document_idle"
    }
  ]
}
